<%- include('partials/header') %>

<main class="categories-page">
    <section class="categories-intro">
        <h1><%= title %></h1>

        <p>
            Explore our service project categories and discover
            opportunities to make a difference in your community.
        </p>
    </section>

    <section class="categories-container">
        <% if (categories.length > 0) { %>
            <% categories.forEach(category => { %>
                <article class="category-card">
                    <h2>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.category_name %>
                        </a>
                    </h2>
                </article>
            <% }); %>
        <% } else { %>
            <p>No categories are currently available.</p>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>
