<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <p>
            Explore our service project categories and discover
            opportunities to make a difference in your community.
        </p>

        <section class="categories-container">

            <article class="category-card">
                <h2>Environmental</h2>
                <p>
                    Projects focused on protecting the environment,
                    promoting sustainability and keeping our
                    communities clean.
                </p>
            </article>

            <article class="category-card">
                <h2>Educational</h2>
                <p>
                    Initiatives that support learning, mentorship,
                    literacy and educational development.
                </p>
            </article>

            <article class="category-card">
                <h2>Community Service</h2>
                <p>
                    Opportunities to support local communities
                    through volunteering and community development.
                </p>
            </article>

            <article class="category-card">
                <h2>Health and Wellness</h2>
                <p>
                    Projects that promote healthy living,
                    healthcare awareness and personal wellbeing.
                </p>
            </article>

        </section>
    </main>

    <%- include('partials/footer') %>