<%- include('partials/header') %>

    <main class="edit-organization-page new-project-page">
        <h1>
            <%= title %>
        </h1>

        <% if (errors && errors.length> 0) { %>
            <div class="error-messages" role="alert">
                <h2>Please correct the following errors:</h2>
                <ul>
                    <% errors.forEach(error=> { %>
                        <li>
                            <%= error %>
                        </li>
                        <% }) %>
                </ul>
            </div>
            <% } %>

                <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
                    <div class="form-group">
                        <label for="title">Project Title</label>
                        <input type="text" id="title" name="title" minlength="3" maxlength="200"
                            value="<%= projectDetails.title %>" required />
                    </div>

                    <div class="form-group">
                        <label for="description">Description</label>
                        <textarea id="description" name="description" maxlength="999"
                            required><%= projectDetails.description %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="location">Location</label>
                        <input type="text" id="location" name="location" maxlength="199"
                            value="<%= projectDetails.location %>" required />
                    </div>

                    <div class="form-group">
                        <label for="date">Project Date</label>
                        <input type="date" id="date" name="date"
                            value="<%= new Date(projectDetails.date).toISOString().slice(0, 10) %>" required />
                    </div>

                    <div class="form-group">
                        <label for="organizationId">Associated Organization</label>
                        <select id="organizationId" name="organizationId" required>
                            <option value="">Select an organization</option>

                            <% organizations.forEach(org=> { %>
                                <option value="<%= org.organization_id %>"
                                    <%=Number(org.organization_id)===Number(projectDetails.organization_id) ? 'selected'
                                    : '' %>
                                    >
                                    <%= org.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <button type="submit">Update Project</button>
                </form>

                <p class="edit-project-link">
                    <a href="/project/<%= projectDetails.project_id %>">Cancel</a>
                </p>
    </main>

    <%- include('partials/footer') %>
