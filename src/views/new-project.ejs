<%- include('partials/header') %>

    <main class="edit-organization-page new-project-page">

        <h1>
            <%= title %>
        </h1>

        <% if (errors && errors.length> 0) { %>
            <div class="error-messages" role="alert">
                <h2>Please correct the following errors:</h2>
                <ul>
                    <% errors.forEach(error=> { %>
                        <li>
                            <%= error %>
                        </li>
                        <% }) %>
                </ul>
            </div>
            <% } %>

                <form action="/new-project" method="POST">

                    <div class="form-group">
                        <label for="title">Project Title</label>

                        <input type="text" id="title" name="title" minlength="3" maxlength="200" required />
                    </div>

                    <div class="form-group">
                        <label for="description">Description</label>

                        <textarea id="description" name="description" maxlength="999" required></textarea>
                    </div>

                    <div class="form-group">
                        <label for="location">Location</label>

                        <input type="text" id="location" name="location" maxlength="199" required />
                    </div>

                    <div class="form-group">
                        <label for="date">Project Date</label>

                        <input type="date" id="date" name="date" required />
                    </div>

                    <div class="form-group">
                        <label for="organizationId">Associated Organization</label>

                        <select id="organizationId" name="organizationId" required>
                            <option value="">Select an organization</option>

                            <% organizations.forEach(org=> { %>
                                <option value="<%= org.organization_id %>">
                                    <%= org.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <button type="submit">Create Project</button>

                </form>

    </main>

    <%- include('partials/footer') %>